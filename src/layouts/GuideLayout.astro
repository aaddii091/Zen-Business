---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GUIDE_NAV } from '../data/guideNav';

interface Props {
  title: string;
  description: string;
  /** Slug of the current guide, e.g. 'refer-a-student'. Marks the sidebar item. */
  slug: string;
  /** Who the guide is written for — shown as a chip under the title. */
  audience?: string;
  /** Rough reading time, e.g. '3 min read'. */
  readingTime?: string;
}

const { title, description, slug, audience, readingTime } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} — Zengarden Guide`} description={description} />
  </head>
  <body>
    <Header />

    <div class="guide-shell">
      <!-- Left sidebar: every topic in the manual -->
      <aside class="guide-sidebar" aria-label="Guide navigation">
        <a href="/resources" class="guide-sidebar-home">← All resources</a>
        {
          GUIDE_NAV.map((section) => (
            <div class="guide-nav-section">
              <p class="guide-nav-heading">{section.title}</p>
              <ul>
                {section.items.map((item) => (
                  <li>
                    {item.href ? (
                      <a
                        href={item.href}
                        class:list={['guide-nav-link', { active: item.slug === slug }]}
                        aria-current={item.slug === slug ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    ) : (
                      <span class="guide-nav-link pending">
                        {item.label}
                        <em>Soon</em>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </aside>

      <main class="guide-main">
        <article class="guide-article">
          <header class="guide-header">
            <h1>{title}</h1>
            <p class="guide-lede">{description}</p>
            <div class="guide-meta">
              {audience && <span class="guide-chip">{audience}</span>}
              {readingTime && <span class="guide-readtime">{readingTime}</span>}
            </div>
          </header>

          <slot />
        </article>
      </main>
    </div>

    <Footer />

    <style>
      .guide-shell {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 48px;
        max-width: 1280px;
        margin: 0 auto;
        padding: 40px 40px 80px;
        align-items: start;
      }

      /* ---------------------------------------------------------- sidebar */

      .guide-sidebar {
        position: sticky;
        top: 108px; /* clears the 84px sticky header */
        max-height: calc(100vh - 140px);
        overflow-y: auto;
        padding-right: 8px;
      }

      .guide-sidebar-home {
        display: inline-block;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--zg-blue);
        margin-bottom: 24px;
      }

      .guide-nav-section + .guide-nav-section {
        margin-top: 28px;
      }

      .guide-nav-heading {
        margin: 0 0 10px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--zg-muted);
      }

      .guide-sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .guide-nav-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        border-radius: var(--zg-radius-md);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--zg-mid);
        line-height: 1.4;
        transition: background var(--zg-transition), color var(--zg-transition);
      }

      a.guide-nav-link:hover {
        background: var(--zg-hover-light);
        color: var(--zg-blue);
      }

      a.guide-nav-link.active {
        background: var(--zg-blue-10);
        color: var(--zg-blue);
      }

      .guide-nav-link.pending {
        color: #9AA3B5;
        cursor: default;
      }

      .guide-nav-link.pending em {
        flex-shrink: 0;
        font-style: normal;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #9AA3B5;
        background: var(--zg-light-bg);
        border-radius: var(--zg-radius-full);
        padding: 2px 8px;
      }

      /* ---------------------------------------------------------- article */

      .guide-article {
        max-width: 820px;
      }

      .guide-header {
        padding-bottom: 28px;
        margin-bottom: 36px;
        border-bottom: 1px solid var(--zg-border-light);
      }

      .guide-header h1 {
        margin: 0 0 12px;
        font-size: 2.5rem;
        line-height: 1.15;
        color: var(--zg-dark);
      }

      .guide-lede {
        margin: 0;
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--zg-muted);
      }

      .guide-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
      }

      .guide-chip {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--zg-blue);
        background: var(--zg-blue-10);
        border-radius: var(--zg-radius-full);
        padding: 5px 14px;
      }

      .guide-readtime {
        font-size: 0.875rem;
        color: var(--zg-muted);
      }

      /* Shared step/figure styling, used by every guide page via <slot />. */
      .guide-article :global(.step) {
        display: grid;
        grid-template-columns: 40px minmax(0, 1fr);
        gap: 20px;
        margin-bottom: 56px;
      }

      .guide-article :global(.step-number) {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--zg-blue);
        color: #fff;
        font-weight: 700;
        font-size: 1.0625rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .guide-article :global(.step-body > h2) {
        margin: 6px 0 10px;
        font-size: 1.375rem;
        line-height: 1.3;
        color: var(--zg-dark);
      }

      .guide-article :global(.step-body p) {
        margin: 0 0 14px;
        font-size: 1rem;
        line-height: 1.7;
        color: var(--zg-mid);
      }

      .guide-article :global(.step-body ul) {
        margin: 0 0 14px;
        padding-left: 20px;
        color: var(--zg-mid);
        line-height: 1.7;
      }

      .guide-article :global(.step-body li) {
        margin-bottom: 6px;
      }

      .guide-article :global(figure) {
        margin: 18px 0 0;
      }

      .guide-article :global(figure img) {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--zg-input-border);
        border-radius: var(--zg-radius-lg);
        box-shadow: var(--zg-shadow-sm);
      }

      .guide-article :global(figcaption) {
        margin-top: 10px;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--zg-muted);
      }

      /* A callout for the things that get people into trouble. */
      .guide-article :global(.guide-note) {
        border-left: 3px solid var(--zg-teal);
        background: rgba(0, 187, 161, 0.07);
        border-radius: 0 var(--zg-radius-md) var(--zg-radius-md) 0;
        padding: 14px 18px;
        margin: 0 0 14px;
      }

      .guide-article :global(.guide-note p) {
        margin: 0;
        font-size: 0.9375rem;
      }

      .guide-article :global(.guide-note strong) {
        color: var(--zg-dark);
      }

      .guide-article :global(.guide-privacy) {
        border-left-color: var(--zg-blue);
        background: var(--zg-blue-10);
      }

      .guide-article :global(.guide-footer) {
        margin-top: 8px;
        padding-top: 28px;
        border-top: 1px solid var(--zg-border-light);
      }

      .guide-article :global(.guide-footer h2) {
        margin: 0 0 12px;
        font-size: 1.25rem;
        color: var(--zg-dark);
      }

      .guide-article :global(.guide-footer p) {
        margin: 0 0 10px;
        color: var(--zg-mid);
        line-height: 1.7;
      }

      @media (max-width: 1024px) {
        .guide-shell {
          grid-template-columns: 1fr;
          gap: 32px;
          padding: 32px 24px 64px;
        }

        .guide-sidebar {
          position: static;
          max-height: none;
          padding-bottom: 24px;
          border-bottom: 1px solid var(--zg-border-light);
        }

        .guide-header h1 {
          font-size: 2rem;
        }

        .guide-article :global(.step) {
          grid-template-columns: 32px minmax(0, 1fr);
          gap: 14px;
        }

        .guide-article :global(.step-number) {
          width: 32px;
          height: 32px;
          font-size: 0.9375rem;
        }
      }
    </style>
  </body>
</html>
